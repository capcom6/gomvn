# Environment Configuration Template for GoMVN
# GoMVN does not load .env files automatically.
# Export these values in your shell, pass them with docker run --env-file,
# or use tooling that explicitly supports dotenv files.
# Never commit real credentials or tokens.

# =============================================================================
# APPLICATION RUNTIME
# =============================================================================

# Configuration file path
# Purpose: Selects the YAML file read by the GoMVN process
# Format: File path
# Default: config.yml in the process working directory when unset or empty
# Example: /opt/gomvn/config.yml
CONFIG_PATH=/opt/gomvn/config.yml

# =============================================================================
# LOCAL HTTP REQUEST TOOLING
# =============================================================================

# Management API credentials
# Purpose: Supplies the Authorization header used by requests.http
# Format: Basic followed by Base64(username:token)
# Default: None
# Example: Basic YWRtaW46VE9LRU5fVE9LRU4=
API_CREDENTIALS=Basic YWRtaW46VE9LRU5fVE9LRU4=

# =============================================================================
# OPTIONAL S3 AUTHENTICATION
# =============================================================================
# These variables are used only when storage.driver is s3 and neither YAML
# storage option login nor password is set. If either YAML value is non-empty,
# GoMVN uses its static provider and bypasses AWS credential environment
# variables. Prefer an IAM role, an AWS profile, or another non-static
# credential source outside local development.

# S3 access key identifier
# Purpose: Supplies the access key when using the AWS default credential chain
# Format: Opaque AWS access key identifier
# Default: None
# Example: EXAMPLE_ACCESS_KEY_ID
AWS_ACCESS_KEY_ID=

# S3 secret access key
# Purpose: Supplies the secret key when using the AWS default credential chain
# Format: Opaque AWS secret access key
# Default: None
# Example: EXAMPLE_SECRET_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=

# S3 session token
# Purpose: Adds temporary session credentials to the AWS default chain
# Format: Opaque AWS session token
# Default: None
# Example: EXAMPLE_SESSION_TOKEN
AWS_SESSION_TOKEN=

# AWS region
# Purpose: Sets the region used by the AWS SDK when S3 storage is enabled
# Format: AWS region name
# Default: Value from the AWS shared configuration, if present
# Example: us-east-1
AWS_REGION=us-east-1

# AWS shared configuration profile
# Purpose: Selects a profile when static credential variables are not used
# Format: Profile name from the AWS shared configuration
# Default: default
# Example: example-profile
AWS_PROFILE=

# =============================================================================
# LOCAL BUILD AND RELEASE OVERRIDES
# =============================================================================
# GoMVN does not load this file. Export the values before invoking make or
# GoReleaser when local overrides are needed.

# Make build version
# Purpose: Selects the version used by the Makefile's local Docker image
# Format: Git tag or version string without a registry scheme
# Default: Latest Git tag, or 0.0.0 when Git cannot resolve one
# Example: v0.4.10
VERSION=v0.4.10

# Local Docker image prefix
# Purpose: Sets the namespace used by the Makefile's docker-build target
# Format: Lowercase registry or namespace prefix without a scheme
# Default: Parent directory name of the repository
# Example: example
DOCKER_CR=example

# GoReleaser container registry prefix
# Purpose: Sets the image prefix read by GoReleaser
# Format: Registry host or host/namespace without a scheme or trailing slash
# Default: None
# Example: ghcr.io
DOCKER_REGISTRY=ghcr.io
